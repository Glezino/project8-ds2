# ============================================================
# Project8 DS2 - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ---- Backend (read by app/config.py via pydantic-settings) ----
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Local PostgreSQL container (docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ---- Frontend (read by src/api/client.ts via import.meta.env) ----
# API URL the browser uses to reach the backend
VITE_API_URL=http://localhost:8000
